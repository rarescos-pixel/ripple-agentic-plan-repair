{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcsExpressControlPlane",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateExpressGatewayService",
        "ecs:DescribeExpressGatewayService",
        "ecs:UpdateExpressGatewayService",
        "ecs:DeleteExpressGatewayService",
        "ecs:ListExpressGatewayServices",
        "ecs:DescribeServiceRevisions",
        "ecs:ListServiceDeployments",
        "ecs:DescribeServiceDeployments",
        "ecs:CreateCluster",
        "ecs:DescribeClusters",
        "ecs:ListTasks",
        "ecs:DescribeTasks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcrBootstrap",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken",
        "ecr:CreateRepository",
        "ecr:DescribeRepositories"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcrRippleRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeImages",
        "ecr:ListImages",
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": "arn:aws:ecr:eu-central-1:873363353521:repository/ripple-canonical-runtime"
    },
    {
      "Sid": "RippleRuntimeRoleAdmin",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole"
      ],
      "Resource": [
        "arn:aws:iam::873363353521:role/RippleEcsTaskExecutionRole",
        "arn:aws:iam::873363353521:role/RippleEcsInfrastructureRole",
        "arn:aws:iam::873363353521:role/RippleEcsTaskRole"
      ]
    },
    {
      "Sid": "PassRippleRuntimeRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::873363353521:role/RippleEcsTaskExecutionRole",
        "arn:aws:iam::873363353521:role/RippleEcsInfrastructureRole",
        "arn:aws:iam::873363353521:role/RippleEcsTaskRole"
      ]
    },
    {
      "Sid": "EcsServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "ecs.amazonaws.com"
        }
      }
    },
    {
      "Sid": "RippleCanonicalSecrets",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:DeleteParameter"
      ],
      "Resource": "arn:aws:ssm:eu-central-1:873363353521:parameter/ripple/canonical/*"
    },
    {
      "Sid": "InspectAndRemoveBootstrapPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": "arn:aws:iam::873363353521:role/RippleGitHubOidcRole"
    }
  ]
}
