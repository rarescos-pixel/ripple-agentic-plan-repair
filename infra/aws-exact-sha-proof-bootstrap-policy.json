{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ExactShaEcsProof",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeExpressGatewayService",
        "ecs:UpdateExpressGatewayService",
        "ecs:RegisterTaskDefinition",
        "ecs:DescribeTaskDefinition"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ExactShaEcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ExactShaEcrRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeImages",
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": "arn:aws:ecr:eu-central-1:873363353521:repository/ripple-canonical-runtime"
    },
    {
      "Sid": "ExactShaSmokeSecrets",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:eu-central-1:873363353521:parameter/ripple/canonical/service-client-secret",
        "arn:aws:ssm:eu-central-1:873363353521:parameter/ripple/canonical/demo-user-password"
      ]
    },
    {
      "Sid": "PassOnlyRippleTaskRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::873363353521:role/RippleEcsTaskExecutionRole",
        "arn:aws:iam::873363353521:role/RippleEcsTaskRole"
      ]
    },
    {
      "Sid": "VerifyInfrastructureRoleIdentity",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::873363353521:role/RippleEcsInfrastructureRole"
    },
    {
      "Sid": "RemoveOnlyThisBootstrap",
      "Effect": "Allow",
      "Action": "iam:DeleteRolePolicy",
      "Resource": "arn:aws:iam::873363353521:role/RippleGitHubOidcRole"
    }
  ]
}
