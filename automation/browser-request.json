{
  "version": 1,
  "url": "http://127.0.0.1:8765/fixtures/browser-automation/form.html",
  "timeoutMs": 30000,
  "steps": [
    {
      "action": "assertTitle",
      "contains": "Browser Automation Fixture"
    },
    {
      "action": "fill",
      "selector": "#name",
      "value": "Rares"
    },
    {
      "action": "setInputFiles",
      "selector": "#file",
      "files": [
        "fixtures/browser-automation/upload.txt"
      ]
    },
    {
      "action": "click",
      "selector": "#submit"
    },
    {
      "action": "assertText",
      "selector": "#result",
      "contains": "Hello Rares; file=upload.txt"
    },
    {
      "action": "screenshot",
      "name": "form-completed.png"
    }
  ],
  "finalScreenshot": "final.png"
}
