{
  "version": 1,
  "provider": "local",
  "url": "https://example.com",
  "timeoutMs": 30000,
  "sensitive": false,
  "allowArtifacts": true,
  "steps": [
    {
      "action": "assertTitle",
      "contains": "Example Domain"
    },
    {
      "action": "assertText",
      "selector": "h1",
      "contains": "Example Domain"
    },
    {
      "action": "screenshot",
      "name": "example-domain.png"
    }
  ],
  "finalScreenshot": "final.png"
}
